enum ArtworkStatus {
  ENABLE,
  DISABLE
}

enum RequestStatus {
	ON_GOING,
    ON_BIDING,
    ENDED,
    FAILED
}

enum RequestBidStatus {
	BIDED,
    SELECTED_BID
}

enum RequestProgressType {
    FIRST_PAYMENT,
    REPORT_1,
    REPORT_2,
    REPORT_3,
    REPORT_4,
    SECOND_PAYMENT,
    NO_ACTION_LEFT
}


enum RequestProgressStatus {
    PENDING,
    SUCCEED,
    FAILED
}

enum ArtworkSellingType {
	DIRECT,
    AUCTION
}

enum ArtworkSellingStatus {
	ON_GOING,
    FINISHED,
    FAILED
}

enum ComplainStatus {
	POSTED,
    ACCEPTED,
    HIDED
}

enum WalletTransactionType {
	DEPOSIT,
    WITHDRAWAL,
    BUY,
    SERVICE_FEE_EARN,
    REQUEST_EARN,
    WITHDRAW_REQUEST_FIRST_PAYMENT_TEMP,
    REQUEST_FIRST_PAYMENT_TEMP,
    REFUND
}

enum WalletTransactionStatus {
	SUCCEED,
    FAILED,
    VERIFING
}

enum SellingBidStatus {
	BIDED,
    FAILED,
    SOLD
}


entity Wallet {
	id Long,
    amount Double
}

entity WalletTransaction {
	id Long,
    amount Double,
    type WalletTransactionType,
    status WalletTransactionStatus,
    createAt LocalDate,
}



entity Artwork {
    id Long,
    name String,
    description String,
    createAt String,
    status ArtworkStatus
    
}

entity ArtworkAsset {
	id Long
}

entity Certificate{
	id Long,
    description String
    }
    
entity Media{
	id Long,
    url String

}

entity Request{
	id Long, 
	description String,  
    status RequestStatus
}

entity RequestAttachment {
	id Long
}

entity RequestProgressAttachment {
    id Long
}

entity RequestBid{
	id Long,
    description String,
    price Long,
    duration Long,
    status RequestBidStatus
}

entity RequestProgress{
	id Long,
    date LocalDate,
    description String,
    type RequestProgressType,
    status RequestProgressStatus,
}

entity ArtworkComment{
id Long,
content String,
createAt LocalDate
}

entity ArtworkLike {
id Long,
createAt LocalDate
}

entity ArtworkCategory{
id Long,
name String
}


entity ArtworkSelling{
id Long,
createAt LocalDate,
type ArtworkSellingType,
status ArtworkSellingStatus,
expectedSellingPrice Long,
}

entity ArtworkComplain {
id Long,
content String,
status ComplainStatus
}


entity SellingBid {
id Long,
bidPrice Long,
createAt LocalDate,
status SellingBidStatus,
}

relationship ManyToOne {
    Request to User{requests} with builtInEntity
    RequestBid to User{requestBids} with builtInEntity
    
    Certificate to User{certificates} with builtInEntity
    ArtworkComplain to User{complains} with builtInEntity

    Artwork{owner} to User{artworks} with builtInEntity

    ArtworkLike{owner} to User with builtInEntity
    ArtworkComment{owner} to User with builtInEntity
}

relationship OneToMany {    
    
    Request{requestBids} to RequestBid
    Request{requestProgresses} to RequestProgress
    Request{attachments} to RequestAttachment 
    
    RequestProgress{attachments} to RequestProgressAttachment

    Artwork{artworkAssets} to ArtworkAsset
    Artwork{comments} to ArtworkComment
    Artwork{complains} to ArtworkComplain
    Artwork{likes} to ArtworkLike
    
    ArtworkSelling{bids} to SellingBid
    
    ArtworkCategory{artworks} to Artwork{category}
    
    Wallet{transactions} to WalletTransaction
}

relationship OneToOne {
	ArtworkAsset{media} to Media
    
    Certificate{media} to Media
    
    RequestAttachment{media} to Media

    RequestProgressAttachment{media} to Media
    
    Artwork{artworkSelling} to ArtworkSelling
    
    RequestProgress{transaction} to WalletTransaction
  	SellingBid{transaction required} to WalletTransaction
    
    Wallet to User with builtInEntity
    
    
}




// Sử dụng Data Transfer Objects (DTO)
dto * with mapstruct


// Cấu hình dịch vụ
service all with serviceImpl

// Cấu hình hậu tố cho React
angularSuffix * with mySuffix

//pagination for entity
paginate Request with infinite-scroll